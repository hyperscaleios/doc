CREATE OR REPLACE PROCEDURE insert_contact(
        fname TEXT,
        lname TEXT,
        phone TEXT,
        email TEXT,
        contactDate DATE
)
LANGUAGE plpgsql
AS $$
BEGIN

        INSERT INTO contact(fname, lname, phone, email,contact_date)
        VALUES (fname, lname, phone, email, contactDate);
        COMMIT;
END;
$$;

